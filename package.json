{
  "name": "vn-lookup",
  "version": "0.1.0",
  "description": "Decky plugin: capture VN text boxes, OCR them locally, and pipe the text to Yomitan for lookup and Anki mining — all from gaming mode.",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/simoncallsen/steam-deck-vn-lookup.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ocr",
    "yomitan",
    "japanese",
    "visual-novel"
  ],
  "author": "Simon Callsen",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.1.1",
    "@types/react-dom": "19.1.1",
    "@types/webpack": "^5.28.5",
    "rollup": "^4.53.3",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "qrcode-generator": "^1.4.4",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
